# Renomeie este arquivo para .env e ajuste os valores

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pizzaria_db
DB_PORT=3306
DB_SSL=false
# Ao usar um banco gratuito hospedado (ex: TiDB Cloud), troque DB_HOST/DB_PORT
# pelos dados fornecidos por eles e coloque DB_SSL=true

PORT=3000

# URLs do(s) site(s) que podem chamar essa API, separadas por vírgula.
# Ex: https://minhapizzaria.com,https://www.minhapizzaria.com
# Se deixar em branco, a API libera CORS para qualquer origem (só recomendado
# em desenvolvimento).
FRONTEND_ORIGINS=

# Use uma string longa e aleatória em produção
JWT_SECRET=troque_esta_chave_por_algo_seguro
